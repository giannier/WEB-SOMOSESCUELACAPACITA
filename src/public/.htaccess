# Escuela Capacita - static site (generated into dist/ by build.mjs)
# No WordPress rewrite rules here. The shop lives in /tienda/ (its own WordPress + .htaccess) and is never rewritten.

Options -Indexes -MultiViews
# index.php stays as fallback: this file is inherited by /tienda/, whose directory index is index.php.
DirectoryIndex index.html index.php
DirectorySlash On
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# ---- Redirects (HTTPS, never touching /tienda/ internals) -------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (skip localhost so the dev/preview setups keep working)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /index.html -> /  and /slug/index.html -> /slug/  (only the static pages, never /tienda/)
  RewriteCond %{REQUEST_URI} !^/tienda/ [NC]
  RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
  RewriteRule ^(.*?)index\.html$ /$1 [R=301,L,NE]

  # Old WordPress front page slug
  RewriteRule ^inicio/?$ / [R=301,L]

  # /slug  ->  /slug/ is handled by mod_dir (DirectorySlash); every page is dist/<slug>/index.html
</IfModule>

# ---- Never serve internals ---------------------------------------------------
# Libro de Reclamaciones backend: only api/reclamo.php and api/token.php are public (see api/.htaccess).
<IfModule mod_alias.c>
  RedirectMatch 403 ^/api/(storage|lib|src|tools|fonts|assets)(/|$)
  RedirectMatch 403 ^/api/(config|config\.secret|config\.secret\.example)\.php$
</IfModule>
<FilesMatch "(^\.|\.(bak|old|orig|sql|log|ini|sh|md|yml|yaml|lock)$|^(package\.json|composer\.(json|lock))$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# ---- Security headers --------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# ---- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# ---- Caching -----------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/webp .webp
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
