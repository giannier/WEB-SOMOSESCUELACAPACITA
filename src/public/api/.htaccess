# Only claim.php-style public endpoints are reachable over HTTP:
# reclamo.php and token.php. Everything else stays closed.
<FilesMatch "\.(php|json|dat|log|z|map|md)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(reclamo|token)\.php$">
  Require all granted
</FilesMatch>

Options -Indexes

<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, no-cache, must-revalidate"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
