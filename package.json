{
  "name": "somosescuelacapacita-static",
  "version": "1.0.0",
  "private": true,
  "description": "Static clone of somosescuelacapacita.com with reusable header/footer layouts and a zero-dependency build.",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "dev": "node build.mjs --serve",
    "check": "node tools/check-assets.mjs",
    "check:deploy": "python tools/check-cpanel-yml.py",
    "test:libro": "node tools/libro-e2e.mjs"
  }
}
